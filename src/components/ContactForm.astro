---
// Форма заявки. ПОКА НЕ ПОДКЛЮЧЕНА к отправке.
// TODO: выбрать, куда слать заявки (Telegram-бот Саше или почта) — обработчик должен
// работать на сервере в РФ (152-ФЗ). До этого форма показывает контакты вместо отправки.
import { site } from '../data/site';

interface Props { title?: string; text?: string }
const {
  title = 'Расскажите о своей ситуации',
  text = 'Первая консультация бесплатно. Можно сразу позвонить или написать в мессенджер.',
} = Astro.props;
---
<section class="cta" id="zayavka">
  <div class="container narrow">
    <h2>{title}</h2>
    <p>{text}</p>

    <div class="cta-links">
      <a class="btn" href={`tel:${site.phoneHref}`}>Позвонить: {site.phone}</a>
      {site.messengers.telegram && <a class="btn ghost" href={site.messengers.telegram} rel="noopener">Telegram</a>}
      {site.messengers.whatsapp && <a class="btn ghost" href={site.messengers.whatsapp} rel="noopener">WhatsApp</a>}
      {site.messengers.max && <a class="btn ghost" href={site.messengers.max} rel="noopener">MAX</a>}
    </div>
    <p class="cta-note">Звонки и MAX: {site.phone} · Telegram и WhatsApp: {site.phoneMessengers} · отвечаю круглосуточно</p>

    <form class="form" data-contact-form novalidate>
      <label>Имя<input name="name" autocomplete="name" required /></label>
      <label>Телефон или ник в мессенджере<input name="contact" autocomplete="tel" required /></label>
      <label>Коротко о ситуации <span class="opt">(необязательно)</span><textarea name="message" rows="3"></textarea></label>
      <label class="check">
        <input type="checkbox" name="consent" required />
        <span>Согласен на <a href="/politika-konfidencialnosti/">обработку персональных данных</a></span>
      </label>
      <button class="btn" type="submit">Отправить заявку</button>
      <p class="form-status" role="status" hidden></p>
    </form>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const status = form.querySelector<HTMLElement>('.form-status')!;
      if (!form.checkValidity()) {
        status.textContent = 'Заполните имя, контакт и отметьте согласие.';
        status.hidden = false;
        return;
      }
      // TODO: отправка заявки. Пока честно говорим, что форма не работает.
      status.textContent = 'Форма пока в разработке. Пожалуйста, позвоните или напишите в мессенджер.';
      status.hidden = false;
    });
  });
</script>
