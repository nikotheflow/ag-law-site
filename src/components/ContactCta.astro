---
// Блок «Свяжитесь со мной» внизу страниц: только кнопки звонка и мессенджеров.
// Формы заявки нет намеренно: Саша сказал, что «позвони / напиши» достаточно.
// Если форма понадобится — нужен обработчик на сервере в РФ и уведомление в Роскомнадзор.
import { site } from '../data/site';

interface Props { title?: string; text?: string }
const {
  title = 'Расскажите о своей ситуации',
  text = 'Первая консультация бесплатно. Позвоните или напишите в мессенджер, отвечаю круглосуточно.',
} = Astro.props;
---
<section class="cta" id="svyaz">
  <div class="container narrow">
    <h2>{title}</h2>
    <p>{text}</p>

    <div class="cta-links">
      <a class="btn" href={`tel:${site.phoneHref}`}>Позвонить: {site.phone}</a>
      {site.messengers.telegram && <a class="btn ghost" href={site.messengers.telegram} rel="noopener">Написать в Telegram</a>}
      {site.messengers.whatsapp && <a class="btn ghost" href={site.messengers.whatsapp} rel="noopener">Написать в WhatsApp</a>}
      {site.messengers.max && <a class="btn ghost" href={site.messengers.max} rel="noopener">MAX</a>}
    </div>
    <p class="cta-note">Звонки и MAX: {site.phone} · Telegram и WhatsApp: {site.phoneMessengers} · {site.email}</p>
  </div>
</section>
