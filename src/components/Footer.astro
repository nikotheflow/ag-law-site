---
import { site, services, nav } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container cols">
    <div>
      <p class="f-title">{site.brand}</p>
      <p>{site.address.city}, {site.address.street}</p>
      <p><a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      {site.hours && <p>{site.hours}</p>}
    </div>
    <div>
      <p class="f-title">Услуги</p>
      <ul>{services.map((s) => <li><a href={s.href}>{s.label}</a></li>)}</ul>
    </div>
    <div>
      <p class="f-title">Сайт</p>
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="/politika-konfidencialnosti/">Политика конфиденциальности</a></li>
      </ul>
    </div>
  </div>
  <div class="container legal">
    <p>{site.legal.entity} · ОГРНИП {site.legal.ogrnip}{site.legal.inn && ` · ИНН ${site.legal.inn}`}</p>
    <p>Информация на сайте не является публичной офертой. © {year}</p>
  </div>
</footer>
