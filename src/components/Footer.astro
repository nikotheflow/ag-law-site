---
import { site, services, nav } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container cols">
    <div>
      <p class="f-title">{site.brand}</p>
      <p>{site.person.shortName}, юрист</p>
      <p>{site.address.city}, {site.address.street}, 1 этаж</p>
      <p>Приём по записи · на связи {site.hours.toLowerCase()}</p>
    </div>
    <div>
      <p class="f-title">Связаться</p>
      <p><a href={`tel:${site.phoneHref}`}>{site.phone}</a> · звонки, MAX</p>
      <p><a href={`tel:${site.phoneMessengersHref}`}>{site.phoneMessengers}</a> · Telegram, WhatsApp</p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
    <div>
      <p class="f-title">Направления</p>
      <ul>{services.filter((s) => s.main).map((s) => <li><a href={s.href}>{s.label}</a></li>)}<li><a href="/uslugi/">Все услуги</a></li></ul>
    </div>
    <div>
      <p class="f-title">Сайт</p>
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="/politika-konfidencialnosti/">Политика конфиденциальности</a></li>
      </ul>
    </div>
  </div>
  <div class="container legal">
    <p>{site.legal.entity} · ОГРНИП {site.legal.ogrnip}{site.legal.inn && ` · ИНН ${site.legal.inn}`}</p>
    <p>Информация на сайте не является публичной офертой · © {year}</p>
  </div>
</footer>
