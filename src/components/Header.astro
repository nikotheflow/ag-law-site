---
import { site, services, nav } from '../data/site';
// текущий адрес без base (на GitHub Pages сайт живёт в подпапке)
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.slice(base.length) || '/';
---
<header class="site-header">
  <div class="container bar">
    <a class="logo" href="/" aria-label={`${site.brand}, на главную`}>
      <span class="logo-ag" aria-hidden="true">{site.brandShort}</span>
      <span class="logo-bar" aria-hidden="true"></span>
      <span class="logo-text">
        <span class="logo-name">юридическая студия</span>
        <span class="logo-sub">{site.person.shortName} · Абакан</span>
      </span>
    </a>

    <nav class="nav" aria-label="Основное меню">
      <details class="services">
        <summary>Услуги</summary>
        <ul>
          {services.map((s) => (
            <li><a href={s.href} aria-current={path === s.href ? 'page' : undefined}>{s.label}</a></li>
          ))}
          <li><a href="/uslugi/">Все услуги</a></li>
        </ul>
      </details>
      {nav.map((n) => (
        <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>

    <div class="contacts">
      <a class="phone" href={`tel:${site.phoneHref}`}>{site.phone}</a>
      <span class="msgr">
        <a href={site.messengers.telegram} rel="noopener">Telegram</a>
        <a href={site.messengers.whatsapp} rel="noopener">WhatsApp</a>
        <span>24/7</span>
      </span>
    </div>
  </div>
</header>

<script>
  // Закрывать меню «Услуги» кликом мимо и по Esc
  const d = document.querySelector<HTMLDetailsElement>('details.services');
  if (d) {
    document.addEventListener('click', (e) => { if (d.open && !d.contains(e.target as Node)) d.open = false; });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') d.open = false; });
  }
</script>
