---
// Каталог услуг: порядок и короткие описания берутся из src/data/site.ts
import Base from '../../layouts/Base.astro';
import { services } from '../../data/site';
const main = services.filter((s) => s.main);
const other = services.filter((s) => !s.main);
---
<Base
  title="Услуги юриста в Абакане — арбитраж, стройка, техприсоединение | AG юридическая студия"
  description="Юридические услуги в Абакане: арбитражные споры, абонентское сопровождение бизнеса, строительные споры, техприсоединение, медицина и репутация, недвижимость, договоры, взыскание долгов."
  path="/uslugi/"
  crumbs={[{ name: 'Услуги', path: '/uslugi/' }]}
>
  <section class="container prose">
    <h1>Услуги юриста в Абакане</h1>
    <p>Работаю прежде всего с бизнесом, но берусь и за дела частных лиц по этим направлениям. Уголовные дела и банкротство не веду.</p>
    <h2>Основные направления</h2>
    <ul class="cards">
      {main.map((s) => <li class="card"><a href={s.href}>{s.label}</a><p>{s.blurb}</p></li>)}
    </ul>
    <h2>Также</h2>
    <ul class="cards">
      {other.map((s) => <li class="card"><a href={s.href}>{s.label}</a><p>{s.blurb}</p></li>)}
    </ul>
  </section>
</Base>
