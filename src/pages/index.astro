---
// Главная. Тексты здесь же (раньше были в content/pages/glavnaya.md):
// у главной своя вёрстка по секциям, Markdown для неё не подходит.
import Base from '../layouts/Base.astro';
import { site, services } from '../data/site';

const main = services.filter((s) => s.main);
const other = services.filter((s) => !s.main);

const facts = [
  { n: '8+ лет', t: 'юридической практики' },
  { n: '65 дел', t: 'в Абаканском горсуде, арбитражных судах и Верховном суде Хакасии' },
  { n: '20', t: 'дел в арбитражных судах' },
  { n: '24/7', t: 'на связи, первая консультация бесплатно' },
];

const why = [
  { h: 'Я был по ту сторону', p: 'Несколько лет работал помощником прокурора и прокурором: надзирал за стройкой, ЖКХ и органами власти, проверял права граждан на медицинское и социальное обеспечение. Знаю, как проверяющий читает документы и почему одни обращения работают, а другие получают отписку.' },
  { h: 'Говорю с бизнесом на одном языке', p: 'Сейчас я ещё и замдиректора по правовым вопросам строительной компании, а до этого руководил подразделением в электроэнергетике. Договоры, подряд и сетевые компании знаю не по учебнику.' },
  { h: 'Веду дело сам', p: 'Вас не передают от менеджера к помощнику. С первой встречи до исполнительного листа вы работаете со мной.' },
  { h: 'Честно оцениваю шансы', p: 'Если дело не стоит того, чтобы идти в суд, я так и скажу. Это дешевле, чем проиграть. Цены понятные: суд от 10 000 ₽, можно в рассрочку или с оплатой по результату.' },
];

const steps = [
  { b: 'Бесплатная консультация', s: 'До часа. Рассказываете ситуацию, показываете документы.' },
  { b: 'План и цена', s: 'Честно говорю о шансах, сроках и стоимости.' },
  { b: 'Договор', s: 'Цену и порядок оплаты фиксируем письменно.' },
  { b: 'Работа', s: 'Переговоры, претензия, иск, суд. Держу в курсе.' },
  { b: 'Результат', s: 'Решение, исполнительный лист, приставы.' },
];

const reviews = [
  { q: 'Грамотный специалист, ответственный и дотошный, отвечает за результат. <…> Помог разрешить непростой спор с поставщиком, решение суда принято в нашу пользу!', a: 'Александра', src: 'Харант' },
  { q: 'Оперативно разобрался в сложном деле. <…> Говорит на одном языке с бизнесом, все четко и понятно.', a: 'Алина Исаева', src: 'Харант' },
];

const faq = [
  { q: 'Консультация правда бесплатная?', a: 'Да, первая консультация бесплатная и длится до часа. Вы рассказываете ситуацию и показываете документы, я говорю, что можно сделать. Письменное заключение с разбором документов стоит от 1 000 ₽.' },
  { q: 'Вы адвокат?', a: 'Нет, я юрист. В арбитражных, гражданских и административных делах юрист может представлять вас в суде так же, как адвокат. Уголовные дела и банкротство я не веду.' },
  { q: 'Вы правда отвечаете круглосуточно?', a: 'Да. Напишите в Telegram или WhatsApp или позвоните, даже ночью и в выходные.' },
  { q: 'Можно ли без личной встречи?', a: 'Да. Большую часть дел можно вести онлайн: документы в мессенджер или на почту, консультации по телефону или видеосвязи.' },
  { q: 'Сколько стоит выиграть дело?', a: 'Зависит от дела. Представительство в суде от 10 000 ₽. Точную стоимость назову после разбора документов и зафиксирую в договоре.' },
  { q: 'Вы гарантируете результат?', a: 'Честный юрист не может гарантировать решение суда. Я гарантирую, что сделаю всё возможное в вашей ситуации, и заранее скажу, если шансы невелики.' },
];

const faqLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
---
<Base
  title="Юрист в Абакане — первая консультация бесплатно | AG юридическая студия"
  description="Юрист для бизнеса в Абакане: арбитраж, абонентское сопровождение, строительные споры, техприсоединение, недвижимость. Бывший прокурор. Консультация бесплатно, 24/7."
  path="/"
  ctaTitle="Расскажите о своей ситуации"
  ctaText="Первая консультация бесплатно, до часа. Позвоните или напишите в мессенджер, отвечаю круглосуточно."
>
  <script type="application/ld+json" set:html={faqLd} slot="head" />

  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Юрист в Абакане · для бизнеса и частных лиц</p>
        <h1>Арбитраж, стройка, техприсоединение и сопровождение бизнеса</h1>
        <p class="hero-lead">
          Я Александр Гришанин, юрист и основатель AG | юридической студии. Работаю прежде всего с бизнесом.
          Раньше служил в органах прокуратуры, поэтому знаю, как система работает изнутри. Веду дела сам:
          от первой консультации до исполнительного листа.
        </p>
        <div class="hero-actions">
          <a class="btn" href={`tel:${site.phoneHref}`}>Позвонить: {site.phone}</a>
          <a class="btn outline-light" href={site.messengers.telegram} rel="noopener">Telegram</a>
          <a class="btn outline-light" href={site.messengers.whatsapp} rel="noopener">WhatsApp</a>
        </div>
        <p class="hero-meta">
          <span>Первая консультация бесплатно</span>
          <span>На связи 24/7</span>
          <span>{site.address.street}, приём по записи</span>
        </p>
      </div>
      <div class="portrait" role="img" aria-label="Место для фотографии Александра Гришанина">
        <span class="portrait-mono" aria-hidden="true">AG</span>
        <p class="portrait-caption"><b>{site.person.shortName}</b>юрист, бывший прокурор <mark class="todo">[ФОТО]</mark></p>
      </div>
    </div>
  </section>

  <section class="facts" aria-label="Коротко в цифрах">
    <div class="container facts-grid">
      {facts.map((f) => <div class="fact"><b>{f.n}</b><span>{f.t}</span></div>)}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Направления</p>
        <h2>С чем я работаю</h2>
        <p>Пять основных направлений и смежные задачи. Уголовные дела и банкротство я не веду.</p>
      </div>
      <div class="dir-grid">
        {main.map((s) => (
          <a class="dir main" href={s.href}>
            <h3>{s.label}</h3>
            <p>{s.blurb}</p>
            <span class="more">Подробнее →</span>
          </a>
        ))}
        <a class="dir" href="/konsultaciya/">
          <h3>Не знаете, с чего начать?</h3>
          <p>Расскажите ситуацию на бесплатной консультации, и я скажу, что делать и сколько это стоит.</p>
          <span class="more">Как проходит консультация →</span>
        </a>
      </div>
      <p class="subhead">Также</p>
      <div class="dir-grid compact">
        {other.map((s) => (
          <a class="dir" href={s.href}>
            <h3>{s.label}</h3>
            <p>{s.blurb}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Почему ко мне обращаются</p>
        <h2>Юрист, который видел систему изнутри</h2>
      </div>
      <div class="why">
        {why.map((w) => <div class="why-item"><h3>{w.h}</h3><p>{w.p}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Как мы будем работать</p>
        <h2>Пять шагов от звонка до результата</h2>
      </div>
      <ol class="steps">
        {steps.map((s) => <li><b>{s.b}</b><span>{s.s}</span></li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Отзывы</p>
        <h2>Что говорят клиенты</h2>
        <p><mark class="todo">[КЕЙС: 3 коротких кейса с суммами — например, дело против Россети Сибирь с неустойкой и астрентом]</mark> <mark class="todo">[ОТЗЫВ: добавить отзывы с Яндекс Карт и 2ГИС]</mark></p>
      </div>
      <div class="reviews">
        {reviews.map((r) => (
          <figure class="review">
            <blockquote>«{r.q}»</blockquote>
            <figcaption>{r.a} · <a href={site.social.harant} rel="noopener">{r.src}</a></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="about">
        <div>
          <p class="eyebrow">О юристе</p>
          <h2>Александр Гришанин</h2>
          <p>Родом из Хакасии. Окончил Институт прокуратуры Уральского государственного юридического университета, служил в органах прокуратуры, потом руководил подразделением в электроэнергетике. Сейчас замдиректора по правовым вопросам строительной компании и ведёт частную практику.</p>
          <p><a href="/o-yuriste/">Подробнее обо мне →</a></p>
        </div>
        <ul class="creds">
          <li><span class="k">Образование</span><span>Институт прокуратуры УрГЮУ им. В. Ф. Яковлева, 2021</span></li>
          <li><span class="k">Стипендии</span><span>Стипендиат Президента РФ, стипендии им. А. А. Собчака и Губернатора Свердловской области</span></li>
          <li><span class="k">Публикации</span><span>«Хозяйство и право» (ВАК), книга о договорном праве в соавторстве</span></li>
          <li><span class="k">Практика</span><span>8+ лет, 65 судебных дел, 6-е место из 807 юристов Абакана на Харанте</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container where">
      <div>
        <p class="eyebrow">Где я работаю</p>
        <h2 style="font-size: clamp(24px, 3vw, 32px); margin: 0 0 14px;">Офис в Абакане, клиенты по всей Хакасии</h2>
        <p>{site.address.city}, {site.address.street}, 1 этаж. У входа вывеска, рядом парковка. Приём по записи: я часто в судах и на выездах.</p>
        <p>Клиентов из Минусинска, Красноярска и Кызыла веду онлайн, при необходимости приезжаю (проезд оплачивает клиент).</p>
      </div>
      <div class="cities" aria-label="География">
        <span>Абакан</span><span>Черногорск</span><span>Саяногорск</span><span>вся Хакасия</span>
        <span class="online">Минусинск · онлайн</span><span class="online">Красноярск · онлайн</span><span class="online">Кызыл · онлайн</span>
      </div>
    </div>
  </section>

  <section class="section home-end">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Частые вопросы</p>
        <h2>Коротко о главном</h2>
      </div>
      <div class="faq">
        {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div>
  </section>
</Base>
